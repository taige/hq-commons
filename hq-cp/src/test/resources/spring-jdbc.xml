<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<!-- dataSource -->
  <bean id="dataSource" class="io.hqwu.commons.cp.HqcpDataSource">
    <property name="propertiesLocation" value="classpath:mysql.properties" />
  </bean>
  <!-- dataSource -->

  <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
    <property name="dataSource" ref="dataSource" />
  </bean>

  <!-- 首先定义抽象的abstractDao，其有一个jdbcTemplate属性，从而可以让继承的子类自动继承jdbcTemplate属性注入； -->
  <bean id="testDao" class="io.hqwu.commons.cp.TestDaoImpl">
    <property name="jdbcTemplate" ref="jdbcTemplate" />
  </bean>

  <!--<bean id="txManager"-->
        <!--class="org.springframework.jdbc.datasource.DataSourceTransactionManager">-->
