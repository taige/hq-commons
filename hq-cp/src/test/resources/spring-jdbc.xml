  <!--</bean>-->

  <!--<tx:annotation-driven transaction-manager="txManager" />-->

  <!--<bean id="txManager2"-->
        <!--class="org.springframework.jdbc.datasource.DataSourceTransactionManager">-->
    <!--<property name="dataSource" ref="dataSource" />-->
  <!--</bean>-->

  <!--<tx:annotation-driven transaction-manager="txManager2" />-->

  <!-- dataSource -->
  <bean id="dataSource2" class="io.hqwu.commons.cp.HqcpDataSource">
    <property name="propertiesLocation" value="classpath:mysql.properties" />
  </bean>
  <!-- dataSource -->

  <bean id="jdbcTemplate2" class="org.springframework.jdbc.core.JdbcTemplate">
    <property name="dataSource" ref="dataSource2" />
  </bean>

  <!-- 首先定义抽象的abstractDao，其有一个jdbcTemplate属性，从而可以让继承的子类自动继承jdbcTemplate属性注入； -->
  <bean id="testDao2" class="io.hqwu.commons.cp.TestDaoImpl2">
    <property name="jdbcTemplate" ref="jdbcTemplate2" />
  </bean>


</beans>
